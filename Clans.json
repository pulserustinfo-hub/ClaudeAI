  "ClanHelp": "<color=#E3E3E3>Not in a clan</color>\n<color=#80EF80>/clan create <tag> [description]</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Create a clan</color>\n<color=#80EF80>/clan join <tag></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Join an invited clan</color>\n<color=#80EF80>/clan reject <tag></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Reject an invite</color>",
  "ClanHelpAdmin": "\n<color=#E3E3E3>Admin commands: type</color> <color=#80EF80>clans.help</color> <color=#E3E3E3>in the F1 console</color>",
  "ClanHelpDefault": "<color=#E3E3E3>Available commands:</color>\n<color=#80EF80>/clan</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Clan information</color>\n<color=#80EF80>/clan home</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Teleport to your clan home</color>\n<color=#80EF80>/clan leave</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Leave your clan</color>",
  "ClanHelpModerator": "\n<color=#E3E3E3>Moderator commands:</color>\n<color=#80EF80>/clan ff</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Toggle friendly fire</color>\n<color=#80EF80>/clan aff</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Toggle allied friendly fire</color>\n<color=#80EF80>/clan invite <partialNameOrId></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Invite a player</color>\n<color=#80EF80>/clan withdraw <partialNameOrId></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Cancel an invite</color>\n<color=#80EF80>/clan kick <partialNameOrId></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Kick a member</color>\n<color=#80EF80>/clan sethome</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Set your clan home</color>",
  "ClanHelpOwner": "\n<color=#E3E3E3>Owner commands:</color>\n<color=#80EF80>/clan ally <tag></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Ally another clan</color>\n<color=#80EF80>/clan description <text></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Set the clan description</color>\n<color=#80EF80>/clan promote <partialNameOrId></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Promote a member</color>\n<color=#80EF80>/clan owner <partialNameOrId></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Set a new owner</color>\n<color=#80EF80>/clan demote <partialNameOrId></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Demote a member</color>\n<color=#80EF80>/clan disband</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Disband your clan (cannot be undone)</color>\n<color=#80EF80>/clan resetally [tag]</color> <color=#E3E3E3>-</color> <color=#E3E3E3>Remove an alliance</color>\n<color=#80EF80>/clan withdrawally <tag></color> <color=#E3E3E3>-</color> <color=#E3E3E3>Withdraw your ally invite</color>",
